# Port sur lequel le serveur ecoute
PORT=4000

# Cle secrete utilisee pour signer les tokens de connexion (JWT)
# IMPORTANT: change cette valeur avant de mettre le serveur en ligne
JWT_SECRET=change-moi-avec-une-vraie-cle-secrete

# Chemin du fichier de base de donnees SQLite
DATABASE_PATH=./src/db/vitalink.sqlite
